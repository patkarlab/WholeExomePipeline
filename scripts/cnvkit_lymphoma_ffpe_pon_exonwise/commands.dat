

docker run --rm -u $(id -u):$(id -g) -v $PWD:$PWD -w $PWD -it ln1:5000/molhemat/cnvkit:1.0 cnvkit.py target TMC_Lymphoma_2.0_master_baseline_hg38_1.04mb_no_NM.bed -o targets.bed


docker run --rm -u $(id -u):$(id -g) -v $PWD:$PWD -v /home/patkarlab-clinical/pipelines/WholeExomePipeline:/home/patkarlab-clinical/pipelines/WholeExomePipeline -w $PWD ln1:5000/molhemat/cnvkit:1.0 bash -c '
for i in $(cat samp.dat); do
