manifest {
	description = 'Exome and Lymphoma params' 
	nextflowVersion = '20.10.0'
}

params {
	input = "${projectDir}/sample_list.csv"
	sequences = "${projectDir}/sequences/"
	outdir = "${projectDir}/Final_Output"
	adapters = "${projectDir}/assets/TruSeq2-PE.fa"
	genome = "${projectDir}/assets/hg19_all.fasta"
	genome_dir = new File(genome).parent
	ind_files = new File(genome).name
	site1 = "${projectDir}/assets/Mills_and_1000G_gold_standard.indels.hg19.sites.vcf"
	site1_idx  = "${projectDir}/assets/Mills_and_1000G_gold_standard.indels.hg19.sites.vcf.idx"
	site2 = "${projectDir}/assets/dbsnp_138.hg19.vcf"
	site2_idx  = "${projectDir}/assets/dbsnp_138.hg19.vcf.idx"
	dbsnp_somatic = "${projectDir}/assets/dbsnp_138.hg19.somatic.vcf"
	bedfile  = "${projectDir}/assets/Exome_hg19_sortd.bed"
	deepvariant = "deepvariant"
	somaticseq = "somaticseq"
	annovar_humandb = "${projectDir}/assets/humandb"
	gen_ref = "${projectDir}/assets/gene_fullxref.txt"
	cava_config = "${projectDir}/assets/config_cava.txt"
	cava_config_lymphoma = "${projectDir}/assets/config_cava_lymphoma.txt"
	site2_zip = "${projectDir}/assets/dbsnp_138.hg19.vcf.gz"
	site2_zip_idx = "${projectDir}/assets/dbsnp_138.hg19.vcf.gz.tbi"
	ensembl_db = "${projectDir}/assets/ensembl75.gz"
	ensembl_db_index = "${projectDir}/assets/ensembl75.gz.tbi"
	pharma_input = "${projectDir}/assets/For_pharmacogenomics.xlsx"
	preprocessed_intervals="${projectDir}/assets/targets.preprocessed.interval_list"
	ploidy_model = "${projectDir}/assets/ploidy24-model"
	cohort_model = "${projectDir}/assets/cohort24-model"
	coverview_config = "${projectDir}/assets/coverview_config.txt"
	control_bqsr_bam = "${projectDir}/assets/REACTIVE1-TwistLymphoma.old_final.bam"
	control_final_bam = "${projectDir}/assets/REACTIVE1-TwistLymphoma.final.bam"
	gridss_exclude_list = "${projectDir}/assets/gridss_exclude_list.bed"
	cnvkit_reference = "${projectDir}/assets/Reference_combpanel.cnn"
	cnvkit_reference_delIG = "${projectDir}/assets/Reference_combpanel_delIG.cnn"
	gene_scatter_list = "${projectDir}/assets/exonwise_lymphoma_list.txt"
}

def humandb_real = new File(params.annovar_humandb).canonicalPath
def reffile_real = new File(params.gen_ref).canonicalPath


trace {
	enabled = true
	file = './Final_Output/pipeline_trace.txt'
	fields = 'hash,task_id,name,status,exit,realtime,%cpu,rss'
}

process {

	// TODO nf-core: Check the defaults for all processes
	// cpus   = { 1      * task.attempt }
	// memory = { 6.GB   * task.attempt }
	// time   = { 4.h    * task.attempt }

	errorStrategy = 'terminate'
	maxRetries    = 1
	maxErrors     = '-1'

	withLabel:process_single {
		cpus   = { 1                   }
		memory = { 6.GB * task.attempt }
		time   = { 4.h  * task.attempt }
	}
	withLabel:process_low {
		cpus   = { 8     * task.attempt }
		memory = { 12.GB * task.attempt }
		time   = { 8.h   * task.attempt }
	}
	withLabel:process_medium {
		cpus   = { 16     * task.attempt }
		memory = { 36.GB * task.attempt }
		time   = { 16.h   * task.attempt }
	}
	withLabel:process_high {
		cpus   = { 32    * task.attempt }
		memory = { 125.GB * task.attempt }
		time   = { 32.h  * task.attempt }
	}
	withLabel:process_long {
		time   = { 20.h  * task.attempt }
	}
	withLabel:process_high_memory {
		memory = { 200.GB * task.attempt }
	}

	withName:TRIM {
		container = 'quay.io/biocontainers/fastp:1.0.1--heae3180_0'
	}
	withName:/(MAPBAM|ABRA_SORT|CHR13_BAM_GEN|SUBSAMPLE|OFFTARGET_BAM_INDEX)/ {
		//container = 'dukegcb/bwa-samtools:latest'
		container = 'molhemat/bwa-samtools:1.0'
	}
	withName:/(MARK_DUPS|ALIGNMENT_METRICS|INSERT_SIZE_METRICS)/ {
		container = 'quay.io/biocontainers/picard:3.1.0--hdfd78af_0'
	}
	withName: /(BQSR|APPLY_BQSR|MUTECT2)/ {
		container = 'quay.io/biocontainers/gatk4:4.3.0.0--py36hdfd78af_0'
	}
	withName:ABRA_BAM {
		//container = 'docker.io/ppawlaczek/abra:latest'
		container = 'molhemat/abra:1.0'
	}
	withName:COVERAGE_MOSDEPTH {
		container = 'quay.io/biocontainers/mosdepth:0.3.3--h37c5b7d_2'
	}
	withName:/(EXTRACT_COV50|FORMAT_DEEPVARIANT|FORMAT_COVERVIEW|FORMAT_CAVA|FORMAT_PINDEL|FORMAT_SOMATICSEQ|FORMAT_CAVA|FORMAT_ANNOVAR|MERGE_CSV_WES|PLOT_CNVKIT|FORMAT_SV_CALLS)/ {
		container = 'molhemat/scipy-bgzip:1.0'
	}
	withName: /(ADDGROUPS|HSMETRICS|MUTECT2|DICT_GEN)/ {
		container = 'quay.io/biocontainers/gatk4:4.4.0.0--py36hdfd78af_0'
	}
	withName:/(COLLECT_READ_COUNTS|DETERMINE_PLOIDY|CALL_GCNV|POSTPROCESS_GCNV)/ {
		container = 'docker.io/broadinstitute/gatk:4.6.0.0'
	}
	withName:FREEBAYES {
		//container = 'staphb/freebayes:latest'
		container = 'molhemat/freebayes:1.0'
	}
	withName:HAPLOTYPECALLER {
		container = 'broadinstitute/gatk3:3.8-1'
	}
	withName:STRELKA {
		container = 'mgibio/strelka:2.9.9'
	}
	withName:PLATYPUS {
		container = 'mattions/platypus:0.8.1-cwl1'
	}
	withName:VARSCAN {
		container = 'molhemat/varscan:1.0'
	}
	withName:/(LOFREQ|SOMATICSEQ_CONCAT|SOMATICSEQ_LYMPHOMA_CONCAT|MERGE_DEEPVAR_GCNV)/ {
		container = 'docker.io/kboltonlab/lofreq:1.0'
	}
	withName: DEEPVARIANT {
		container = 'google/deepvariant:1.6.1'
	}
	withName:/(VEP|VEP_ANALYSIS)/ {
		container = 'hydragenetics/vep:107'
		containerOptions = "-v /home/vishram/.vep:/.vep"
	}
	withName:/(ANNOVAR|ANNOVAR_LYMPHOMA|IGV_PREPROCESS)/ {
		container = 'docker.io/bioinfochrustrasbourg/annovar:2018Apr16'
		containerOptions = "-v ${humandb_real}:/databases/humandb -v ${reffile_real}:/databases/gene_fullxref.txt"
	}
	withName:PINDEL_FLT3 {
		container = 'shuangbroad/pindel:v0.2.5b8'
	}
	withName:/(SOMATICSEQ|SOMATICSEQ_LYMPHOMA)/ {
		container = 'molhemat/somaticseq:1.0'
	}
	withName:IFCNV {
		container = 'pderouault/ifcnv:2.2.0'
	}
	withName:CAVA {
		container = 'molhemat/cava_nf:1.0'
	}
	withName:COVERAGE_COVERVIEW {
		container = 'molhemat/coverview:1.0'
	}
	withName:COVERAGE_BEDTOOLS {
		container = 'quay.io/biocontainers/bedtools:2.31.1--h13024bc_3'
	}
	withName:DEEPSOMATIC {
		container = 'google/deepsomatic:1.6.1'
	}
	withName:SVABA {
		container = 'cmopipeline/svaba:0.0.2'
	}
	withName:LUMPY_PREPROCESS {
		container = 'anthmcg/samtools-python:3.11'
	}
	withName:LUMPY {
		container = 'halllab/lumpy:v0.2.13-2d611fa'
	}
	withName:GRIDSS {
		container = 'gridss/gridss:2.13.2'
	}
	withName:DELLY {
		container = 'molhemat/delly:1.0'
	}
	withName:MANTA {
		container = 'genieusgenomics/manta:1.6.0'
	}
	withName:CNVKIT {
		container = 'molhemat/cnvkit:1.0'
	}

}

def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
timeline {
	enabled = true
	file    = "${params.outdir}/execution_timeline_${trace_timestamp}.html"
}
report {
	enabled = true
	file    = "${params.outdir}/execution_report_${trace_timestamp}.html"
	overwrite = true
}
trace {
	enabled = true
	file = "${params.outdir}/pipeline_trace_${trace_timestamp}.txt"
	fields = 'hash,task_id,name,status,exit,realtime,%cpu,rss'
}
dag {
	enabled = true
	file    = "${params.outdir}/pipeline_dag_${trace_timestamp}.html"
}

profiles {
	docker {
		docker.enabled          = true
		docker.runOptions       = '-u $(id -u):$(id -g)'
	}
}

executor {
	name = 'local'
	queueSize = 10
}
